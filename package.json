{
  "name": "reader-vault",
  "version": "1.2.2",
  "private": true,
  "author": "EERIE",
  "description": "Cross-platform reader and library (Electron + Capacitor) with local storage and URL loading",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "dev:electron": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:electron": "npm run build && electron-builder",
    "cap:sync": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.1.0",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/share": "^8.0.1",
    "@capacitor/status-bar": "^8.0.1",
    "@capgo/capacitor-file-picker": "^8.1.2",
    "@capgo/native-purchases": "^8.4.6",
    "@tauri-apps/api": "^2.11.1",
    "axios": "^1.6.2",
    "pako": "^2.1.0",
    "pdfjs-dist": "^5.4.624"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.1.0",
    "@tauri-apps/cli": "^2.11.3",
    "concurrently": "^9.0.0",
    "electron": "^40.4.1",
    "electron-builder": "^24.13.3",
    "png2icons": "^2.0.1",
    "vite": "^5.4.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.eerie.readervault",
    "productName": "Reader Vault",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/",
      "electron/",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "appx"
      ]
    },
    "appx": {
      "identityName": "20715EerieGoesD.ReaderVault",
      "publisher": "CN=A2A89A47-0B2B-4C32-B85C-9753888A9FFC",
      "displayName": "Reader Vault",
      "publisherDisplayName": "EERIE",
      "applicationId": "ReaderVault"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    }
  },
  "overrides": {
    "tar": "7.5.7",
    "esbuild": "0.25.1"
  }
}
